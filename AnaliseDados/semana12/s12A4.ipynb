import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt

from datetime import datetime
# Tentar ler o arquivo CSV novamente, especificando o delimitador como ponto e vírgula
# e ignorando linhas mal formatadas para evitar o ParserError.
athletes = pd.read_csv('./athletes.csv', sep=',', on_bad_lines='skip')

# Calcular a idade dos atletas com base na data de nascimento
athletes['birth_date'] = pd.to_datetime(athletes['birth_date'], errors='coerce')
current_year = datetime.now().year
athletes['age'] = current_year - athletes['birth_date'].dt.year

# Remover linhas onde a idade não pôde ser calculada (devido a datas de nascimento inválidas)
athletes.dropna(subset=['age'], inplace=True)
athletes['age'] = athletes['age'].astype(int)

# Calcular os percentis para encontrar a faixa etária onde estão 50% dos atletas
# A função "quantile(0.25)" nos dá o valor abaixo do qual estão 25% das idades (o "25º percentil").
# "quantile(0.75)" nos dá o valor abaixo do qual estão 75% das idades (o "75º percentil").
# Isso ajuda a encontrar uma faixa central onde metade dos atletas está concentrada.
age_25 = athletes['age'].quantile(0.25)
age_75 = athletes['age'].quantile(0.75)

# Gráfico melhorado: Adicionando título e ajuste visual, com anotações
# Cria uma nova figura para desenhar o gráfico, ajustando o tamanho dela.
plt.figure(figsize=(8, 6))

# Cria um gráfico de barras para mostrar quantos atletas existem em cada idade.
# "bins=100" indica que vamos dividir as idades em 100 partes para ter mais detalhes.
# "color='green'" define a cor verde para as barras e "edgecolor='black'" adiciona um contorno preto nas barras.
sns.histplot(data=athletes, x='age', bins=100, kde=False, color='green', edgecolor='black')

# Define o título que aparecerá no topo do gráfico.
plt.title('Distribuição de Atletas por Faixa Etária')

# Define o rótulo (nome) do eixo X, que mostra as idades.
plt.xlabel('Idade')

# Define o rótulo do eixo Y, que mostra o número de atletas.
plt.ylabel('Número de Atletas')

# Adiciona uma grade no fundo do gráfico para facilitar a visualização dos dados.
# "linestyle='--'" usa linhas pontilhadas e "alpha=0.6" deixa a cor das linhas um pouco transparente.
plt.grid(True, linestyle='--', alpha=0.6)

# Adicionar anotação para a faixa onde estão concentrados 50% dos atletas
# Desenha uma linha azul na posição do 25º percentil (age_25) para marcar o início da faixa.
plt.axvline(age_25, color='blue', linestyle='--', label='25º Percentil')

# Desenha uma linha vermelha na posição do 75º percentil (age_75) para marcar o final da faixa.
plt.axvline(age_75, color='red', linestyle='--', label='75º Percentil')

# Preenche a área entre as linhas azul e vermelha com uma cor amarela clara para destacar a faixa central.
# Essa faixa representa onde estão concentrados 50% dos atletas.
plt.fill_betweenx(y=[0, plt.gca().get_ylim()[1]], x1=age_25, x2=age_75, color='yellow', alpha=0.3)

# Adiciona uma legenda para explicar o que são as linhas azul e vermelha.
plt.legend()

# Anotação textual
# Adiciona um texto no gráfico para explicar que 50% dos atletas têm idades entre os valores marcados pelas linhas.
# "plt.text()" insere o texto no local especificado. Aqui, posicionamos um pouco à direita da faixa amarela.
# "bbox" cria uma caixa de fundo branco ao redor do texto para facilitar a leitura.
plt.text((age_25 + age_75) / 2, plt.gca().get_ylim()[1] * 0.8,
         '50% dos atletas estão\nentre {} e {} anos'.format(int(age_25), int(age_75)),
         ha='center', fontsize=10, bbox=dict(facecolor='white', alpha=0.6))

# Exibe o gráfico na tela.
plt.show()